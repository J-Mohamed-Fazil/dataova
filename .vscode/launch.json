{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Run DATOVA Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Launch Frontend in Browser",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "DATOVA Fullstack (Backend + Browser)",
      "configurations": ["FastAPI: Run DATOVA Backend", "Launch Frontend in Browser"]
    }
  ]
}
