# LLM Provider Keys (Insert your actual keys below)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Active Strategy: auto | openai | gemini | offline_deterministic
DEFAULT_LLM_PROVIDER=auto

# Server & Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database (Default is zero-setup SQLite, or provide PostgreSQL URI)
# DATABASE_URL=postgresql://user:password@localhost:5432/datova
